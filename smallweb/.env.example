# Main app URL, used for the Login / Start Trial / Go to app links.
# Defaults to https://app.showshowshow.app if unset.
PUBLIC_APP_URL=https://app.showshowshow.app

# Umami analytics (optional). Both must be set for the script to load.
PUBLIC_UMAMI_URL=
PUBLIC_UMAMI_ID=

# Note: this site is fully static and makes no API calls, so it needs no
# backend URL. Astro inlines PUBLIC_* values at build time, which means the
# host must have these set before the build runs, not at request time.
